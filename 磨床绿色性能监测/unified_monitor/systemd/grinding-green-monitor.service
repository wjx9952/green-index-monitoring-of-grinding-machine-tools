[Unit]
Description=Grinding Machine Green Performance Unified Monitor
After=graphical-session.target
Conflicts=noise-monitor.service

[Service]
Type=simple
User=w52
SupplementaryGroups=dialout gpio i2c spi
WorkingDirectory=/home/w52/unified_monitor
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/w52/.Xauthority
ExecStart=/home/w52/unified_monitor/run.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
